{
  "name": "frameos",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@frameos/web",
    "dev:studio": "turbo run dev --filter=@frameos/studio",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "prettier --write . && turbo run lint:fix",
    "spellcheck": "cspell lint .",
    "spellcheck:fix": "cspell lint . --words-only --no-summary",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "cspell": "^9.1.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "catalog:",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "prettier-plugin-tailwindcss-canonical-classes": "^0.1.5",
    "turbo": "^2.5.8"
  }
}
