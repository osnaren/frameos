# FrameOS environment variables
#
# Copy this file to .env and fill in whatever you have. Every integration
# below is optional — with nothing set, the app runs entirely on the bundled
# Pocket Worlds fixture content and photos (src/server/providers/mock-data.ts).
# Once Sanity credentials are added, the provider switches to live data
# automatically; no code changes required. See docs/README.md for the full
# architecture and reference docs this maps to.

# ---- Sanity — content AND photos (site settings, pages, photo library) ----
# Free tier: 100GB asset storage, 100GB bandwidth/month, an included on-the-fly
# image pipeline (resize/crop/format via URL params), and automatic EXIF/
# palette/blur-placeholder extraction on upload — see https://www.sanity.io/pricing.
# A read token is required if your dataset is private (recommended, so draft/
# unpublished/archived photos can never be fetched directly by anyone who
# discovers your project id).
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_TOKEN=
SANITY_API_VERSION=2025-02-19
SANITY_STUDIO_PROJECT_TITLE=FrameOS Studio
# Shared secret configured on the Sanity webhook (Settings > API > Webhooks).
# Configure the webhook's GROQ projection as:
#   {"documentId": _type, "slug": slug.current, "_updatedAt": _updatedAt}
SANITY_WEBHOOK_SECRET=

# ---- Upstash Redis — webhook idempotency + event ordering -----------------
# Optional but recommended in production. Free tier: 10,000 commands/day,
# 256MB — far beyond a personal portfolio's webhook volume. Without it, the
# app falls back to a degraded in-memory store (works within a single warm
# serverless instance only, cleared on cold start).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Vercel — cache tag invalidation REST fallback -------------------------
# Only used if the runtime invalidateByTag() call fails; safe to leave blank
# otherwise. If set, use a token scoped to this project with cache-purge access.
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# ---- Reconcile / cron endpoint auth ----------------------------------------
# CRON_SECRET is auto-sent by Vercel Cron as `Authorization: Bearer <value>`
# once this is set as a project environment variable — nothing else to wire.
# RECONCILE_SECRET is a second accepted token for manual/emergency calls.
# Vercel Hobby (free) cron jobs run at most once per day — see vercel.json.
CRON_SECRET=
RECONCILE_SECRET=

# ---- Error tracking (optional) ---------------------------------------------
# Not wired to a real Sentry client today — structured JSON logs already go to
# Vercel Runtime Logs for free, which keeps the app dependency-light and fully
# within free tiers. Only set this after adding @sentry/* yourself.
SENTRY_DSN=

# ---- Client-visible ---------------------------------------------------------
# Absolute site URL for canonical links/SEO when it can't be inferred from
# request headers (e.g. local dev).
VITE_SITE_URL=http://localhost:3000
